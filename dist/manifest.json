{
  "manifest_version": 3,
  "name": "English Tooltip",
  "version": "0.1.0",
  "description": "Selecciona texto en inglés y ve la traducción al español en un tooltip. Guarda vocabulario para aprender.",
  "permissions": ["storage", "contextMenus", "alarms", "notifications"],
  "host_permissions": [
    "https://api.mymemory.translated.net/*",
    "https://translation.googleapis.com/*",
    "https://api.deepl.com/*",
    "https://api-free.deepl.com/*",
    "https://api.dictionaryapi.dev/*",
    "https://api.anthropic.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "English Tooltip: activado (clic para desactivar)" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
